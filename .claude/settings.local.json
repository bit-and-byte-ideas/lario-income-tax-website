{
  "permissions": {
    "allow": [
      "Bash(npx:*)",
      "Bash(cat:*)",
      "Bash(tree:*)",
      "Bash(npm run build:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(pre-commit install:*)",
      "Bash(git config:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rm:*)",
      "Bash(npm run lint:md:*)",
      "Bash(npm run lint:md:fix:*)",
      "Bash(ls:*)",
      "Bash(npm run format:check:*)",
      "Bash(npm run format:*)",
      "Bash(pre-commit run:*)",
      "Bash(mkdocs build:*)",
      "Bash(pip install:*)",
      "Bash(python3:*)",
      "Bash(source:*)",
      "Bash(printf:*)",
      "Bash(ng generate:*)",
      "Bash(pkill:*)",
      "Bash(npm start)",
      "Bash(curl:*)",
      "Bash(ng build:*)",
      "Bash(file:*)",
      "Bash(npm test:*)",
      "Bash(ng add:*)",
      "Bash(ng test:*)",
      "Bash(chmod:*)",
      "Bash(./validate.sh:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(npm run lint:yaml:*)",
      "Bash(ng extract-i18n:*)",
      "Bash(npm run build:en:*)",
      "Bash(npm run build:es:*)",
      "Bash(npm run build:i18n:*)",
      "Bash(npm run extract-i18n:*)",
      "WebFetch(domain:green-bush-0c265bf0f.4.azurestaticapps.net)",
      "Bash(graphify export *)",
      "Bash(graphify benchmark *)",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Linear__list_issue_statuses",
      "mcp__claude_ai_Linear__save_issue"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(echo \"$CLAUDE_TOOL_INPUT\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('file_path',''))\" 2>/dev/null); [[ \"$FILE\" =~ \\.(ts|html|scss)$ ]] && npx prettier --write \"$FILE\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CHANGED=$(git diff --name-only 2>/dev/null; git diff --cached --name-only 2>/dev/null); if echo \"$CHANGED\" | grep -qE '\\.(ts|html)$'; then echo 'i18n: TypeScript/HTML files changed — run: npm run extract-i18n'; fi; if echo \"$CHANGED\" | grep -qE '^src/'; then echo 'Tests: src/ files changed — run: npm test'; fi"
          }
        ]
      }
    ]
  }
}
